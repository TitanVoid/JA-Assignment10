<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21" fx:controller="gruppog3.RegistrationFormController">
    <children>
        <Label layoutX="89.0" layoutY="50.0" text="Ciao! Compila il form e rispondi alle domande">
            <font>
                <Font size="22.0" />
            </font>
        </Label>
        <Label fx:id="nameLabel" layoutX="281.0" layoutY="100.0" text="Nome">
            <font>
                <Font size="14.0" />
            </font>
        </Label>
        <Label fx:id="surnameLabel" layoutX="269.0" layoutY="165.0" text="Cognome">
            <font>
                <Font size="14.0" />
            </font>
        </Label>
        <Label fx:id="questionLabel" layoutX="217.0" layoutY="236.0" text="Quante domande desideri?">
            <font>
                <Font size="14.0" />
            </font>
        </Label>
        <TextField fx:id="textFieldName" layoutX="225.0" layoutY="120.0" />
        <TextField fx:id="textFieldSurname" layoutX="226.0" layoutY="187.0" />
        <TextField fx:id="textFieldQuestion" layoutX="225.0" layoutY="256.0" />
        <Button fx:id="startButton" layoutX="273.0" layoutY="330.0" mnemonicParsing="false" onAction="#onStart" text="Inizia!">
            <font>
                <Font size="14.0" />
            </font>
        </Button>
    </children>
</AnchorPane>
